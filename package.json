{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter portfolio dev",
    "build": "pnpm --filter portfolio build",
    "build:withResume": "pnpm --filter portfolio build:withResume",
    "studio": "pnpm --filter portfolio-sanity-studio dev",
    "typegen": "pnpm --filter portfolio-sanity-studio typegen",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "format": "vp fmt && vp lint",
    "check": "vp check",
    "test": "vp test",
    "deploy:local": "pnpm --filter portfolio run deploy"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.20.0"
  },
  "packageManager": "pnpm@10.20.0"
}
