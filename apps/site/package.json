{
  "name": "portfolio",
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:withResume": "pnpm run build && pnpm run generate:resume",
    "preview": "astro preview",
    "generate:resume": "node --import=tsx ./scripts/generate-resume.ts",
    "generate:cover-letter": "node --import=tsx ./scripts/generate-cover-letter.ts",
    "astro": "astro",
    "deploy": "pnpm run build:withResume && wrangler deploy",
    "deploy:dryrun": "pnpm run build:withResume && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@adam/portfolio-sanity": "workspace:*",
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.1.2",
    "@corvu/tooltip": "^0.2.2",
    "@fontsource/poppins": "^5.3.0",
    "@sanity/client": "^8.14.1",
    "astro": "^7.4.4",
    "astro-portabletext": "^1.0.1",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "embla-carousel-solid": "^8.6.0",
    "pdf-lib": "^1.17.1",
    "playwright-chromium": "^1.64.1",
    "postcss-nested": "^9.0.1",
    "sanitize.css": "^13.0.0",
    "solid-js": "^1.9.18",
    "solid-toast": "^0.5.0"
  },
  "devDependencies": {
    "@portabletext/types": "^4.0.2",
    "@types/node": "^26.6.5",
    "embla-carousel": "^8.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
