---
import DateRange from '../DateRange.astro';
import { PortableText } from 'astro-portabletext';

type Props = {
  title?: string;
  subtitle?: string;
  startDate?: string;
  endDate?: string;
  // PortableText accepts a typegen-shaped block array; the renderer validates shape at runtime.
  description?: unknown;
};

const { title, subtitle, startDate, endDate, description } = Astro.props;
---

<section>
  {
    (title || subtitle) && (
      <header>
        <div>
          {title && <h3>{title}</h3>}
          {subtitle && <h4>{subtitle}</h4>}
        </div>
        {startDate && <DateRange startDate={startDate} endDate={endDate} />}
      </header>
    )
  }
  {description && <PortableText value={description as never} />}
</section>

<style>
  section {
    padding: var(--gap, 1em) 0;
    border-bottom: var(--border-alternate);
    page-break-inside: avoid;
    &:last-child {
      border-bottom: none;
    }
  }
  header {
    display: flex;
    flex-flow: row wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-xs, 0.25em);
    margin-bottom: var(--gap, 1em);
  }

  h3 {
    margin-bottom: var(--gap-sm, 0.5em);
  }
  h3,
  h4 {
    font-size: 1.12em;
    line-height: 1.2;
    margin: 0;
    padding: 0;
    page-break-after: avoid;
    @media print {
      color: var(--color-secondary-charcoal-gray) !important;
      background-color: unset !important;
    }
  }
  h3 {
    color: var(--color-secondary-light-gray);
    background-color: var(--color-background-primary);
  }
  h4 {
    font-weight: normal;
  }
</style>
