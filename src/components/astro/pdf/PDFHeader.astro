---
import { sanityImg } from '../../../utils/sanity';

type Social = {
  platform: string;
  url: string;
};

type Logo = { svgUrl?: string | null; pngUrl?: string | null };

type Props = {
  logo: Logo;
  contactInfo: {
    name?: string;
    title?: string;
    email?: string;
    socials?: Social[];
  };
};

const { logo, contactInfo } = Astro.props;

// Try to inline the SVG (build-time) if an .svg URL exists
let svgHtml: string | null = null;
if (logo?.svgUrl?.endsWith('.svg')) {
  try {
    const res = await fetch(logo.svgUrl);
    svgHtml = res.ok ? await res.text() : null;
  } catch {
    /* ignore */
  }
}

const hasPrimaryInfo = contactInfo?.name || contactInfo?.title;
const hasSecpondaryInfo = contactInfo?.email || contactInfo?.socials?.length;
const hasContactInfo = hasPrimaryInfo || hasSecpondaryInfo;
---

{
  hasContactInfo && (
    <header>
      {hasPrimaryInfo && (
        <div>
          <div>
            {contactInfo?.name && <h1>{contactInfo.name}</h1>}
            {contactInfo?.title && <h2>{contactInfo.title}</h2>}
          </div>
          {svgHtml ? (
            <div class="logo">
              <Fragment set:html={svgHtml} />
            </div>
          ) : logo?.svgUrl ? (
            <div class="logo">
              <img src={logo.svgUrl} alt="Logo" loading="lazy" />
            </div>
          ) : logo?.pngUrl ? (
            <div class="logo">
              <img src={sanityImg(logo.pngUrl, { w: 240 })} alt="Logo" loading="lazy" />
            </div>
          ) : null}
        </div>
      )}
      {hasSecpondaryInfo && (
        <div>
          <ul>
            {contactInfo?.email && (
              <li>
                <a href={`mailto:${contactInfo.email}`} title="Click to email Adam">
                  {contactInfo.email}
                </a>
              </li>
            )}
            {contactInfo?.socials?.map((social: Social) => (
              <li>
                <a href={social.url} title={`Click to view ${social.platform}`} target="_blank">
                  {social.platform}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </header>
  )
}

<style>
  header {
    display: flex;
    flex-flow: column nowrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-lg, 2em);
    color: var(--color-text-primary);
    background-color: var(--color-background-primary);
    border-bottom: 1px solid var(--color-secondary-lavender-gray);
    padding: var(--gap, 1em) 0 var(--gap-lg, 2em) 0;
    margin: 0;
    > div {
      display: flex;
      flex-flow: column nowrap;
      justify-content: space-between;
      align-items: stretch;
      gap: var(--gap-xs, 0.25em);
    }
    @media (min-width: 580px) {
      flex-flow: row nowrap;
      align-items: stretch;
    }
    @media (min-width: 48rem) {
      padding: var(--gap, 1em) var(--gap, 1em) var(--gap-lg, 2em) var(--gap, 1em);
    }
    @media print {
      background-color: var(--color-background-primary) !important;
      padding: var(--gap, 1em);
    }
  }
  h1,
  h2 {
    font-size: 2em;
    margin: 0;
    padding: 0;
    line-height: 1;
    color: var(--color-secondary-lavender-gray);
  }
  h1 {
    font-weight: 900;
  }
  h2 {
    font-weight: normal;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-flow: column nowrap;
    justify-content: space-between;
    gap: var(--gap-xs, 0.25em);
    height: 100%;
    font-size: 0.9em;
    @media (min-width: 580px) {
      align-items: flex-end;
      text-align: right;
    }
  }
  a {
    color: var(--color-cta-celestial-gold);
    font-weight: 700;
  }
  a:hover {
    text-decoration: underline;
  }
  .logo {
    margin-top: var(--gap, 1em);
    svg {
      width: 6.5em;
      max-width: 100%;
      height: auto;
    }
  }
</style>
